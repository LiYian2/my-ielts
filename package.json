{
  "private": true,
  "packageManager": "pnpm@8.6.10",
  "scripts": {
    "build": "vite build && node scripts/prune-legacy-topic-audio.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test -- --run && pnpm validate:content && pnpm build && pnpm check:pages-assets",
    "check:pages-assets": "node scripts/validate-pages-assets.mjs dist",
    "deploy:pages": "wrangler pages deploy dist --project-name liyian2-my-ielts --branch master",
    "dev": "vite --port 3333 --open",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "validate:content": "vitest run test/vocabulary-learning/content.test.ts",
    "up": "taze major -I"
  },
  "dependencies": {
    "@vueuse/core": "^10.1.2",
    "vue": "^3.3.4",
    "vue-router": "^4.2.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.39.5",
    "@iconify-json/carbon": "^1.1.17",
    "@iconify-json/ph": "^1.1.12",
    "@iconify-json/simple-icons": "^1.1.87",
    "@types/node": "^20.2.5",
    "@unocss/eslint-config": "^0.53.0",
    "@unocss/reset": "^0.53.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue-macros/volar": "^0.10.2",
    "@vue/test-utils": "^2.3.2",
    "eslint": "^8.42.0",
    "jsdom": "^22.1.0",
    "lint-staged": "^13.2.2",
    "pnpm": "^8.6.0",
    "taze": "^0.10.2",
    "typescript": "^5.1.3",
    "unocss": "^0.53.0",
    "unplugin-auto-import": "^0.16.4",
    "unplugin-vue-components": "^0.25.0",
    "unplugin-vue-macros": "^2.2.1",
    "vite": "^4.3.9",
    "vite-plugin-pages": "^0.31.0",
    "vitest": "^0.31.4",
    "vue-tsc": "^1.6.5",
    "wrangler": "4.118.0"
  },
  "eslintConfig": {
    "root": true,
    "ignorePatterns": [
      ".github/**",
      "docs/**",
      "src/pages/reading/reading538words.js",
      "src/pages/vocabulary/index.vue",
      "src/pages/vocabulary/vocabulary.js",
      "src/pages/writing/index.vue"
    ],
    "extends": [
      "@antfu/eslint-config",
      "@unocss/eslint-config"
    ]
  }
}
